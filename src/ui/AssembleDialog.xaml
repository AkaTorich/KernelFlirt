<Window x:Class="KernelFlirt.UI.AssembleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assemble" Width="520" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="Consolas" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Address -->
        <TextBlock Grid.Row="0" Text="Address:" VerticalAlignment="Center" Margin="0,0,8,6" />
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAddress" Margin="0,0,0,6"
                   VerticalAlignment="Center" Foreground="{DynamicResource DsmNumberBrush}" />

        <!-- Original bytes -->
        <TextBlock Grid.Row="1" Text="Original bytes:" VerticalAlignment="Center" Margin="0,0,8,6" />
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtOriginalBytes" Margin="0,0,0,6"
                   VerticalAlignment="Center" Foreground="{DynamicResource HexBrush}" />

        <!-- Original instruction -->
        <TextBlock Grid.Row="2" Text="Original:" VerticalAlignment="Center" Margin="0,0,8,6" />
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtOriginal" Margin="0,0,0,6"
                   VerticalAlignment="Center" Foreground="{DynamicResource MnemonicBrush}" />

        <!-- Input -->
        <TextBlock Grid.Row="3" Text="New instruction:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtInput" Padding="4" Margin="0,0,0,8"
                 Background="{DynamicResource BgPanelBrush}" Foreground="{DynamicResource FgBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource FgBrush}"
                 TextChanged="OnInputChanged"
                 ToolTip="Enter assembly (e.g. mov eax, 1) or hex bytes (e.g. B8 01 00 00 00)" />

        <!-- Preview: assembled bytes -->
        <TextBlock Grid.Row="4" Text="Assembled bytes:" VerticalAlignment="Center" Margin="0,0,8,6" />
        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtPreviewBytes" Margin="0,0,0,6"
                   VerticalAlignment="Center" Foreground="{DynamicResource HexBrush}" />

        <!-- Preview: with NOP pad -->
        <TextBlock Grid.Row="5" Text="With NOP pad:" VerticalAlignment="Center" Margin="0,0,8,6" />
        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtPaddedBytes" Margin="0,0,0,6"
                   VerticalAlignment="Center" Foreground="{DynamicResource DsmJumpBrush}" />

        <!-- Fill with NOPs checkbox -->
        <CheckBox Grid.Row="6" Grid.ColumnSpan="2" x:Name="ChkNopPad"
                  Content="Fill remaining space with NOPs" IsChecked="True" Margin="0,4,0,8"
                  Foreground="{DynamicResource FgBrush}"
                  Checked="OnInputChanged" Unchecked="OnInputChanged" />

        <!-- Error / info -->
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" x:Name="TxtStatus" TextWrapping="Wrap"
                   Foreground="{DynamicResource BreakpointBrush}" VerticalAlignment="Top" />

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Assemble" Click="OnAssemble" IsDefault="True" Padding="16,6" Margin="0,0,8,0"
                    x:Name="BtnAssemble" IsEnabled="False" />
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" Padding="16,6" />
        </StackPanel>
    </Grid>
</Window>
