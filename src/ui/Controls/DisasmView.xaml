<UserControl x:Class="KernelFlirt.UI.Controls.DisasmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Lucida Console" FontSize="11"
             Background="{DynamicResource BgBrush}"
             Foreground="{DynamicResource FgBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBgBrush}" Padding="4,2">
            <TextBlock Text="Disassembly" FontWeight="SemiBold" />
        </Border>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer x:Name="ScrollArea"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource BgBrush}">
                    <ItemsControl x:Name="InstructionList">
                    <ItemsControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Toggle Breakpoint (F2)" Click="OnContextToggleBp" InputGestureText="F2" />
                            <MenuItem Header="Toggle HW Breakpoint" Click="OnContextToggleHwBp" />
                            <MenuItem Header="Set Conditional Breakpoint..." Click="OnContextSetCondBp" />
                            <MenuItem Header="Set Log Breakpoint..." Click="OnContextSetLogBp" />
                            <Separator />
                            <MenuItem Header="Run to Cursor (F4)" Click="OnContextRunToCursor" InputGestureText="F4" />
                            <MenuItem Header="Skip Instruction (Ctrl+F8)" Click="OnContextSkipInstruction" InputGestureText="Ctrl+F8" />
                            <MenuItem Header="Set RIP Here" Click="OnContextSetRipHere" />
                            <Separator />
                            <MenuItem Header="Add Bookmark/Note..." Click="OnContextAddNote" />
                            <MenuItem Header="Edit Bookmark/Note..." Click="OnContextEditNote" />
                            <MenuItem Header="Remove Bookmark/Note" Click="OnContextRemoveNote" />
                            <Separator />
                            <MenuItem Header="Follow in Dump" Click="OnContextFollowInDump" />
                            <MenuItem Header="Follow in Disassembler" Click="OnContextFollowInDisasm" />
                            <MenuItem Header="Go Back" Click="OnContextGoBack" InputGestureText="Esc" />
                            <Separator />
                            <MenuItem Header="Copy Address" Click="OnContextCopyAddress" />
                            <MenuItem Header="Copy Line" Click="OnContextCopyLine" />
                            <MenuItem Header="Copy All" Click="OnContextCopyAll" />
                            <Separator />
                            <MenuItem Header="Search Binary..." Click="OnContextSearchBinary" />
                            <MenuItem Header="Search Strings..." Click="OnContextSearchStrings" />
                            <Separator />
                            <MenuItem Header="Assemble... (Space)" Click="OnContextAssemble" InputGestureText="Space" />
                            <MenuItem Header="NOP Instruction" Click="OnContextNopInstruction" />
                            <MenuItem Header="Fill with NOPs..." Click="OnContextFillNops" />
                            <Separator />
                            <MenuItem Header="Decompile Function" Click="OnContextDecompile" />
                        </ContextMenu>
                    </ItemsControl.ContextMenu>
                </ItemsControl>
                </ScrollViewer>

                <!-- Column resize overlay — dashed vertical lines with draggable Thumbs -->
                <Grid x:Name="ColumnHeader" IsHitTestVisible="True" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <!-- Each cell just contains a Thumb on its right edge -->
                    <Thumb Grid.Column="0" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                           DragDelta="OnSplitterDrag0" Tag="0">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Line X1="3" Y1="0" X2="3" Y2="10000" Stroke="#8899A0"
                                          StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb Grid.Column="1" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                           DragDelta="OnSplitterDrag1" Tag="1">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Line X1="3" Y1="0" X2="3" Y2="10000" Stroke="#8899A0"
                                          StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb Grid.Column="2" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                           DragDelta="OnSplitterDrag2" Tag="2">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Line X1="3" Y1="0" X2="3" Y2="10000" Stroke="#8899A0"
                                          StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
