<Window x:Class="KernelFlirt.UI.Views.RemoteFileBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Remote File (.exe / .sys)"
        Width="700" Height="550"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        FontFamily="Consolas" FontSize="13"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <DockPanel Margin="8">
        <!-- Top: Drive selector + Path -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Drive:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="DriveCombo" Width="160" SelectionChanged="OnDriveChanged"
                      DisplayMemberPath="Display" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Path:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="PathBox" VerticalAlignment="Center" IsReadOnly="True" />
        </DockPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Up" Click="OnUpClick" Width="60" Margin="0,0,8,0"
                    ToolTip="Go to parent directory" />
            <Button Content="Refresh" Click="OnRefreshClick" Width="80" Margin="0,0,8,0" />
            <Button x:Name="OpenBtn" Content="Open &amp; Debug" Click="OnOpenClick" Width="110"
                    Margin="0,0,8,0" IsDefault="True" IsEnabled="False" />
            <Button Content="Cancel" Click="OnCancelClick" Width="80" IsCancel="True" />
        </StackPanel>

        <!-- File list -->
        <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" MouseDoubleClick="OnFileDoubleClick"
                  SelectionChanged="OnFileSelectionChanged"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="3*" Binding="{Binding Display}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Size" Width="100" Binding="{Binding SizeText}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
