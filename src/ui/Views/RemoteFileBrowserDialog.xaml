<Window x:Class="KernelFlirt.UI.Views.RemoteFileBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote File Browser"
        Width="900" Height="600" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="Consolas" FontSize="13"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnPreviewKeyDown">

    <DockPanel Margin="6">
        <!-- Top toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="BackBtn" Content="◀" Click="OnBackClick" Width="30" ToolTip="Back (Alt+Left)"
                        Margin="0,0,2,0" IsEnabled="False" />
                <Button x:Name="FwdBtn" Content="▶" Click="OnForwardClick" Width="30" ToolTip="Forward (Alt+Right)"
                        Margin="0,0,2,0" IsEnabled="False" />
                <Button Content="▲" Click="OnUpClick" Width="30" ToolTip="Up (Backspace)" Margin="0,0,4,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ComboBox x:Name="DriveCombo" Width="120" SelectionChanged="OnDriveChanged"
                          DisplayMemberPath="Display" VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button Content="⟳" Click="OnRefreshClick" Width="30" ToolTip="Refresh (F5)" Margin="4,0,0,0" />
            </StackPanel>

            <TextBox x:Name="PathBox" VerticalAlignment="Center" Margin="4,0,0,0"
                     KeyDown="OnPathBoxKeyDown" />
        </DockPanel>

        <!-- Bottom status bar + buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="DebugBtn" Content="Open &amp; Debug" Click="OnOpenDebugClick" Width="110"
                        Margin="4,0,0,0" IsDefault="True" IsEnabled="False"
                        ToolTip="Open selected .exe/.sys in debugger" />
                <Button Content="Close" Click="OnCloseClick" Width="70" Margin="4,0,0,0" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource FgDimBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- File list -->
        <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  MouseDoubleClick="OnFileDoubleClick"
                  SelectionChanged="OnFileSelectionChanged"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CanUserSortColumns="True" CanUserReorderColumns="False"
                  GridLinesVisibility="None" HeadersVisibility="Column"
                  RowHeight="24">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="CtxOpenDebug" Header="Open &amp; Debug" Click="OnOpenDebugClick" FontWeight="Bold" />
                    <Separator />
                    <MenuItem x:Name="CtxDownload" Header="Download..." Click="OnDownloadClick" />
                    <MenuItem x:Name="CtxUpload" Header="Upload here..." Click="OnUploadClick" />
                    <Separator />
                    <MenuItem Header="New Folder" Click="OnNewFolderClick" />
                    <MenuItem x:Name="CtxRename" Header="Rename" Click="OnRenameClick" InputGestureText="F2" />
                    <MenuItem x:Name="CtxDelete" Header="Delete" Click="OnDeleteClick" InputGestureText="Del" />
                    <Separator />
                    <MenuItem x:Name="CtxCopyPath" Header="Copy Path" Click="OnCopyPathClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="" Width="30" Binding="{Binding Icon}" IsReadOnly="True" CanUserSort="False" />
                <DataGridTextColumn Header="Name" Width="3*" Binding="{Binding Display}" SortMemberPath="Display">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Size" Width="100" Binding="{Binding SizeText}" SortMemberPath="FileSize">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Modified" Width="130" Binding="{Binding DateText}" SortMemberPath="LastWriteTime" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
