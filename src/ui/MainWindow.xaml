<Window x:Class="KernelFlirt.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KernelFlirt.UI.ViewModels"
        xmlns:conv="clr-namespace:KernelFlirt.UI.Converters"
        xmlns:ctrl="clr-namespace:KernelFlirt.UI.Controls"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:models="clr-namespace:KernelFlirt.UI.Models"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Icon="icon.ico"
        Title="KernelFlirt - Kernel Debugger"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}"
        FontFamily="Lucida Console" FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:HexValueConverter x:Key="HexConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolVisConv" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolVisConv" />

        <!-- Per-panel font sizes (changed at runtime via Ctrl+±/wheel) -->
        <sys:Double x:Key="StackFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>

        <!-- Cell style that overrides selection colors and shows BP red -->
        <Style x:Key="BpCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
            <Style.Triggers>
                <!-- Normal selection: dark blue -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
                </Trigger>
                <!-- Breakpoint row: red -->
                <DataTrigger Binding="{Binding HasBreakpoint}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BpRowBrush}" />
                </DataTrigger>
                <!-- Selected + breakpoint: brighter red -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasBreakpoint}" Value="True" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#B03030" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BpRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBreakpoint}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BpRowBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- F2 handled in PreviewKeyDown for tab-aware BP toggling -->
        <KeyBinding Key="F4" Command="{Binding RunToCursorCommand}" />
        <KeyBinding Key="F5" Command="{Binding ContinueExecutionCommand}" />
        <KeyBinding Key="F7" Command="{Binding StepInCommand}" />
        <KeyBinding Key="F8" Command="{Binding StepOverCommand}" />
        <KeyBinding Key="F8" Modifiers="Ctrl" Command="{Binding SkipInstructionCommand}" />
        <KeyBinding Key="F9" Command="{Binding RunCommand}" />
        <KeyBinding Key="F12" Command="{Binding PauseCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="G" Command="{Binding GoToRipCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="F9" Command="{Binding StepOutCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="F" Command="{Binding SearchBinaryCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource BgLightBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Process..." Command="{Binding OpenProcessCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/attach-process.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open &amp; _Debug (.exe)..." Command="{Binding OpenAndDebugCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/open-file.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Debug _Service..." Command="{Binding DebugServiceCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/service.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Connect Kernel..." Command="{Binding ConnectKernelCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/connect.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Disconnect" Command="{Binding DisconnectKernelCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/disconnect.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/exit.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem Header="_Attach (by PID)" Command="{Binding AttachProcessCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/attach-process.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Detach" Command="{Binding DetachProcessCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/detach.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Re_start Sample" Command="{Binding RestartSampleCommand}" ToolTip="Relaunch the last opened sample and break at its entry point">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/restart.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Run" Command="{Binding RunCommand}" InputGestureText="F9">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/run.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Pause" Command="{Binding PauseCommand}" InputGestureText="F12">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/pause.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Continue" Command="{Binding ContinueExecutionCommand}" InputGestureText="F5">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/continue.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Step _Into" Command="{Binding StepInCommand}" InputGestureText="F7">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/step-into.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step _Over" Command="{Binding StepOverCommand}" InputGestureText="F8">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/step-over.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step O_ut" Command="{Binding StepOutCommand}" InputGestureText="Ctrl+F9">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/step-out.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="S_kip Instruction" Command="{Binding SkipInstructionCommand}" InputGestureText="Ctrl+F8">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/skip.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Run to _Cursor" Command="{Binding RunToCursorCommand}" InputGestureText="F4">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/run-to-cursor.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Toggle _Breakpoint" Command="{Binding ToggleBreakpointCommand}" InputGestureText="F2">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/breakpoint.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Toggle _HW Breakpoint" Command="{Binding ToggleHwBreakpointCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/breakpoint-hw.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Toggle HW _Write Watch" Command="{Binding ToggleHwWriteBreakpointCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/breakpoint-write.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Toggle HW _R/W Watch" Command="{Binding ToggleHwRwBreakpointCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/breakpoint-rw.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Toggle _Memory Breakpoint" Command="{Binding ToggleMemoryBreakpointCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/breakpoint-mem.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Set _Conditional Breakpoint..." Command="{Binding SetConditionalBreakpointCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/bp-cond.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Set _Log Breakpoint..." Command="{Binding SetLogBreakpointCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/bp-log.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Remove _All Breakpoints" Command="{Binding RemoveAllBreakpointsCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/bp-remove-all.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator />
            </MenuItem>
            <MenuItem Header="_Search">
                <MenuItem Header="_Binary Pattern..." Command="{Binding SearchBinaryCommand}" InputGestureText="Ctrl+F">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Tabs/search.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_String References..." Command="{Binding SearchStringsCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/search-string.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Intermodular Calls" Command="{Binding SearchIntermodularCallsCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/search-intermod.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh All" Click="OnRefreshAllClick">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/refresh.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Go to _RIP" Command="{Binding GoToRipCommand}" InputGestureText="Ctrl+G">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/goto-rip.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Add _Bookmark..." Command="{Binding AddBookmarkCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Plugins/bookmarks.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Refresh _SEH Chain" Click="OnRefreshSehClick">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/refresh-seh.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Restore All _Patches" Command="{Binding RestoreAllPatchesCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/restore-patches.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Live Hints (x64dbg-style)" IsCheckable="True"
                          IsChecked="{Binding LiveHintsEnabled}"
                          ToolTip="Show register values and symbol annotations next to each instruction. Slower when on."/>
                <Separator />
                <MenuItem Header="_Fullscreen" Click="OnToggleFullscreen" InputGestureText="F11">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/fullscreen.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Themes" x:Name="ThemesMenu">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/settings.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Appearance..." Click="OnAppearanceClick">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/settings.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Settings..." Click="OnSettingsClick">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/settings.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Symbols">
                <MenuItem Header="_Load All Symbols" Command="{Binding LoadAllSymbolsCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/symbol-load.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Set Symbol _Path..." Command="{Binding SetSymbolPathCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/symbol-path.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Clear Symbol Cache" Command="{Binding ClearSymbolCacheCommand}">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/symbol-clear.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Plugins" x:Name="PluginsMenu" />
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick">
                    <MenuItem.Icon><svgc:SvgViewbox Source="/Resources/Icons/Menu/about.svg" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBgBrush}" Padding="4,2">
            <WrapPanel>
                <Button Command="{Binding OpenProcessCommand}"
                        ToolTip="Attach to process" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/attach-process.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding OpenAndDebugCommand}"
                        ToolTip="Open and debug .exe" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/open-file.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding ConnectKernelCommand}"
                        ToolTip="Connect to kernel driver"
                        Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolVisConv}}"
                        Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/connect-green.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding DisconnectKernelCommand}"
                        ToolTip="Disconnect from kernel driver"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolVisConv}}"
                        Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/connect.svg" Width="20" Height="20"/>
                </Button>

                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="8,2" />

                <TextBlock Text="PID:" VerticalAlignment="Center" Margin="4,0" />
                <TextBox x:Name="PidBox" Width="80" VerticalAlignment="Center"
                         Text="{Binding TargetPid, UpdateSourceTrigger=PropertyChanged}" />
                <Button Command="{Binding ToggleAttachCommand}" Padding="3">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="ToolTip" Value="Attach to process by PID" />
                            <Setter Property="Content">
                                <Setter.Value>
                                    <svgc:SvgViewbox Source="/Resources/Icons/attach-process.svg" Width="20" Height="20"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDebugHookActive}" Value="True">
                                    <Setter Property="ToolTip" Value="Detach from process" />
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <svgc:SvgViewbox Source="/Resources/Icons/Menu/detach.svg" Width="20" Height="20"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="8,2" />

                <Button Command="{Binding RunCommand}" ToolTip="Run (F9)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/run.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding RestartSampleCommand}" ToolTip="Restart sample" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/restart.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding PauseCommand}" ToolTip="Pause (F12)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/pause.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding ContinueExecutionCommand}" ToolTip="Continue (F5)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/continue.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding StepInCommand}" ToolTip="Step Into (F7)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/step-into.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding StepOverCommand}" ToolTip="Step Over (F8)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/step-over.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding SkipInstructionCommand}" ToolTip="Skip instruction (Ctrl+F8)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/skip.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding StepOutCommand}" ToolTip="Step Out (Ctrl+F9)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/step-out.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding RunToCursorCommand}" ToolTip="Run to Cursor (F4)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/run-to-cursor.svg" Width="20" Height="20"/>
                </Button>

                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="8,2" />

                <Button Click="OnBpButtonClick" ToolTip="Toggle breakpoint (F2)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/breakpoint.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding ToggleHwBreakpointCommand}" ToolTip="Toggle hardware breakpoint" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/breakpoint-hw.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding ToggleHwWriteBreakpointCommand}" ToolTip="Toggle HW write watchpoint" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/breakpoint-write.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding ToggleHwRwBreakpointCommand}" ToolTip="Toggle HW read/write watchpoint" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/breakpoint-rw.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding ToggleMemoryBreakpointCommand}" ToolTip="Toggle memory breakpoint (PAGE_GUARD)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/breakpoint-mem.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding SetConditionalBreakpointCommand}" ToolTip="Set conditional breakpoint" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/bp-cond.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding SetLogBreakpointCommand}" ToolTip="Set log breakpoint" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/bp-log.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding RemoveAllBreakpointsCommand}" ToolTip="Remove all breakpoints" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/bp-remove-all.svg" Width="20" Height="20"/>
                </Button>

                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="8,2" />

                <!-- Search group -->
                <Button Command="{Binding SearchBinaryCommand}" ToolTip="Search binary pattern (Ctrl+F)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Tabs/search.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding SearchStringsCommand}" ToolTip="Search string references" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/search-string.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding SearchIntermodularCallsCommand}" ToolTip="Intermodular calls" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/search-intermod.svg" Width="20" Height="20"/>
                </Button>

                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="8,2" />

                <!-- View group -->
                <Button Click="OnRefreshAllClick" ToolTip="Refresh all" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/refresh.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding GoToRipCommand}" ToolTip="Go to RIP (Ctrl+G)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/goto-rip.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding AddBookmarkCommand}" ToolTip="Add bookmark" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Plugins/bookmarks.svg" Width="20" Height="20"/>
                </Button>
                <Button Click="OnRefreshSehClick" ToolTip="Refresh SEH chain" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/refresh-seh.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding RestoreAllPatchesCommand}" ToolTip="Restore all patches" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/restore-patches.svg" Width="20" Height="20"/>
                </Button>
                <Button Click="OnToggleFullscreen" ToolTip="Fullscreen (F11)" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/fullscreen.svg" Width="20" Height="20"/>
                </Button>
                <Button Click="OnSettingsClick" ToolTip="Settings…" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/settings.svg" Width="20" Height="20"/>
                </Button>

                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="8,2" />

                <!-- Symbols group -->
                <Button Command="{Binding LoadAllSymbolsCommand}" ToolTip="Load all symbols" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/symbol-load.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding SetSymbolPathCommand}" ToolTip="Set symbol path…" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/symbol-path.svg" Width="20" Height="20"/>
                </Button>
                <Button Command="{Binding ClearSymbolCacheCommand}" ToolTip="Clear symbol cache" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/symbol-clear.svg" Width="20" Height="20"/>
                </Button>

                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="8,2" />

                <!-- File group: debug service -->
                <Button Command="{Binding DebugServiceCommand}" ToolTip="Debug service…" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/service.svg" Width="20" Height="20"/>
                </Button>

                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="8,2" />

                <!-- Help -->
                <Button Click="OnAboutClick" ToolTip="About" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/Menu/about.svg" Width="20" Height="20"/>
                </Button>

                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="8,2" />

                <TextBlock Text="Addr:" VerticalAlignment="Center" Margin="4,0" />
                <TextBox x:Name="GoToBox" Width="160" VerticalAlignment="Center"
                         KeyDown="OnGoToKeyDown" />
                <Button Click="OnGoToClick" ToolTip="Go to address" Padding="3">
                    <svgc:SvgViewbox Source="/Resources/Icons/goto.svg" Width="20" Height="20"/>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="PID: " />
                    <Run Text="{Binding TargetPid, Mode=OneWay}" />
                    <Run Text="  TID: " />
                    <Run Text="{Binding SelectedThreadId, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
        <!-- Command Console (OllyDbg/x64dbg-style) — sits above the status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgLightBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="4,2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Command:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="2,0,6,0"/>
                <TextBlock DockPanel.Dock="Right" x:Name="ConsoleOutput"
                           Foreground="{DynamicResource StackAnnotationBrush}"
                           VerticalAlignment="Center" Margin="6,0,4,0"
                           TextTrimming="CharacterEllipsis"/>
                <Grid>
                    <TextBox x:Name="ConsoleInput" FontFamily="Lucida Console" FontSize="12"
                             Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             Padding="4,2" VerticalContentAlignment="Center"
                             TextChanged="OnConsoleTextChanged"
                             KeyDown="OnConsoleKeyDown"
                             LostFocus="OnConsoleLostFocus"
                             ToolTip="Enter command (g/t/p/bp/bc/bl/d/r/?/dis/u/findall). Press : to focus."/>
                    <!-- Ghost-text hint (faded), shown when input is empty -->
                    <TextBlock x:Name="ConsoleHint" IsHitTestVisible="False"
                               Foreground="{DynamicResource FgDimBrush}" Opacity="0.5"
                               FontFamily="Lucida Console" FontSize="12"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Text="g · t · p · bp · bc · bl · d · dis · r · ? · findall  (press : to focus)"/>
                    <!-- Autocomplete popup -->
                    <Popup x:Name="ConsolePopup" PlacementTarget="{Binding ElementName=ConsoleInput}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           Focusable="False">
                        <Border Background="{DynamicResource BgLightBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="0" MinWidth="340">
                            <ListBox x:Name="ConsoleSuggestions" BorderThickness="0"
                                     FontFamily="Lucida Console" FontSize="12"
                                     Background="{DynamicResource BgLightBrush}"
                                     MaxHeight="220"
                                     PreviewMouseLeftButtonUp="OnSuggestionPicked">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                       Foreground="{DynamicResource MnemonicBrush}"
                                                       MinWidth="80" Margin="4,2,8,2"/>
                                            <TextBlock Text="{Binding Hint}"
                                                       Foreground="{DynamicResource FgDimBrush}"
                                                       Margin="0,2,4,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TopRow" Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="BottomRow" Height="1.5*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Navigation Bar (memory map) -->
            <Canvas x:Name="NavBar" Grid.Row="0" Height="26" Background="{DynamicResource BgBrush}"
                    SnapsToDevicePixels="True" ClipToBounds="True"
                    MouseLeftButtonDown="NavBar_MouseLeftButtonDown"
                    MouseMove="NavBar_MouseMove"
                    ToolTipService.InitialShowDelay="0"
                    ToolTipService.ShowDuration="60000" />

            <!-- Top: TabControl with all panels -->
            <TabControl Grid.Row="1" x:Name="MainTabControl">

                <!-- Tab: Disassembly + Registers -->
                <TabItem Tag="Disassembly" IsSelected="True">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/Resources/Icons/Tabs/disassembly.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Disassembly" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TopLeftCol" Width="3*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="TopRightCol" Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <ctrl:DisasmView x:Name="DisasmControl" Grid.Column="0" />

                        <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource BorderBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                        <!-- Registers -->
                        <DockPanel Grid.Column="2" x:Name="RegistersPanel">
                            <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBgBrush}" Padding="4,2">
                                <TextBlock Text="Registers" FontWeight="SemiBold" />
                            </Border>
                            <!-- Flags grid at bottom -->
                            <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,1" Padding="4">
                                <ItemsControl x:Name="FlagsGrid">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="5,2" Margin="1" Background="{DynamicResource BgLightBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    MouseLeftButtonDown="OnFlagClick" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" MinWidth="22"
                                                               Foreground="{DynamicResource RegisterBrush}" />
                                                    <TextBlock Text="{Binding Value}" FontWeight="Bold" Margin="4,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value}" Value="1">
                                                                        <Setter Property="Foreground" Value="#FF5370"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Grid>
                            <DataGrid x:Name="RegistersGrid" ItemsSource="{Binding Registers}" IsReadOnly="True"
                                      AutoGenerateColumns="False" HeadersVisibility="None"
                                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                      MouseDoubleClick="OnRegisterDoubleClick">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Modify Value…" Click="OnRegisterModify" FontWeight="Bold" />
                                        <MenuItem Header="Toggle Flag" Click="OnRegisterToggleFlag" />
                                        <MenuItem Header="Zero Register" Click="OnRegisterZero" />
                                        <MenuItem Header="Increment (+1)" Click="OnRegisterIncrement" />
                                        <MenuItem Header="Decrement (-1)" Click="OnRegisterDecrement" />
                                        <Separator />
                                        <MenuItem Header="Copy All Registers" Command="{Binding CopyRegisterValueCommand}" />
                                        <MenuItem Header="Follow in Dump" Click="OnRegisterFollowInDump" />
                                        <MenuItem Header="Follow in Disassembler" Click="OnRegisterFollowInDisasm" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Reg" Width="60" Binding="{Binding Name}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource RegisterBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Value" Width="140" Binding="{Binding ValueHex}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ValueChangedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Annotation" Width="*" Binding="{Binding Annotation}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource StackAnnotationBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Column resize overlay for Registers -->
                            <Grid x:Name="RegColumnOverlay" IsHitTestVisible="True" HorizontalAlignment="Left">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="RegColumnXform"/>
                                </Grid.RenderTransform>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="RegNameCol" Width="60"/>
                                    <ColumnDefinition x:Name="RegValCol" Width="140"/>
                                </Grid.ColumnDefinitions>
                                <Thumb Grid.Column="0" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                                       DragDelta="OnRegSplitterDrag0">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Line X1="3" Y1="0" X2="3" Y2="10000" Stroke="{DynamicResource SplitterDashBrush}"
                                                      StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb Grid.Column="1" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                                       DragDelta="OnRegSplitterDrag1">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Line X1="3" Y1="0" X2="3" Y2="10000" Stroke="{DynamicResource SplitterDashBrush}"
                                                      StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- Tab: Breakpoints -->
            <TabItem Tag="Breakpoints">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/breakpoints.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Breakpoints" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="BpGrid" ItemsSource="{Binding Breakpoints}" IsReadOnly="True"
                          AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                          MouseDoubleClick="OnBreakpointDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Go to Address" Click="OnBreakpointGoTo" />
                            <MenuItem Header="Follow in Dump" Click="OnBreakpointFollowInDump" />
                            <MenuItem Header="Decompile" Click="OnBreakpointDecompile" />
                            <MenuItem Header="Remove" Click="OnBreakpointRemove" />
                            <MenuItem Header="Remove All" Command="{Binding RemoveAllBreakpointsCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Handle" Width="60" Binding="{Binding Handle}" />
                        <DataGridTextColumn Header="Address" Width="160" Binding="{Binding AddressHex}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Type" Width="70" Binding="{Binding TypeName}" />
                        <DataGridTextColumn Header="Status" Width="50" Binding="{Binding StatusText}" />
                        <DataGridTextColumn Header="Hits" Width="50" Binding="{Binding HitCount}" />
                        <DataGridTextColumn Header="Condition" Width="120" Binding="{Binding Condition}" />
                        <DataGridTextColumn Header="Module" Width="*" Binding="{Binding ModuleName}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab: Modules -->
            <TabItem Tag="Modules">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/modules.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Modules" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="ModulesGrid" ItemsSource="{Binding Modules}" IsReadOnly="True"
                          AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                          MouseDoubleClick="OnModuleDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Follow in Disassembler" Click="OnModuleFollowInDisasm" />
                            <MenuItem Header="Follow in Dump" Click="OnModuleFollowInDump" />
                            <MenuItem Header="Copy Base Address" Click="OnModuleCopyBase" />
                            <Separator />
                            <MenuItem Header="Show Imports" Click="OnModuleShowImports" />
                            <MenuItem Header="Show Exports" Click="OnModuleShowExports" />
                            <MenuItem Header="Show Functions" Click="OnModuleShowFunctions" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Base" Width="160" Binding="{Binding BaseHex}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Size" Width="100" Binding="{Binding SizeHex}" />
                        <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab: Kernel Modules -->
            <TabItem Tag="Kernel Modules">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/kernel-modules.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Kernel Modules" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="KernelModulesGrid" ItemsSource="{Binding KernelModules}" IsReadOnly="True"
                          AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                          MouseDoubleClick="OnKernelModuleDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Go to Entry Point" Click="OnKernelModuleGoToEntry" />
                            <MenuItem Header="Go to Base" Click="OnKernelModuleGoToBase" />
                            <MenuItem Header="Follow in Dump" Click="OnKernelModuleFollowInDump" />
                            <Separator />
                            <MenuItem Header="Copy Base Address" Click="OnKernelModuleCopyBase" />
                            <MenuItem Header="Copy Name" Click="OnKernelModuleCopyName" />
                            <Separator />
                            <MenuItem Header="Show Imports" Click="OnKernelModuleShowImports" />
                            <MenuItem Header="Show Functions" Click="OnKernelModuleShowFunctions" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Base" Width="160" Binding="{Binding BaseHex}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Size" Width="100" Binding="{Binding SizeHex}" />
                        <DataGridTextColumn Header="Index" Width="60" Binding="{Binding LoadOrder}" />
                        <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab: Threads -->
            <TabItem Tag="Threads">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/threads.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Threads" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="ThreadsGrid" ItemsSource="{Binding Threads}" IsReadOnly="True"
                          AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                          MouseDoubleClick="OnThreadDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Switch to Thread" Click="OnThreadSwitch" />
                            <MenuItem Header="Freeze (Suspend++)" Click="OnThreadSuspend"
                                      ToolTip="Increment SuspendCount of this thread. To run the whole process press F9 — frozen threads stay suspended." />
                            <MenuItem Header="Unfreeze (Resume--)" Click="OnThreadResume"
                                      ToolTip="Decrement SuspendCount. Doesn't run the process — use F9 (Run) for that." />
                            <MenuItem Header="Follow Start Address" Click="OnThreadFollowStart" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TID" Width="80" Binding="{Binding ThreadId}" />
                        <DataGridTextColumn Header="Start Address" Width="160" Binding="{Binding StartAddressHex}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="State" Width="120" Binding="{Binding StateText}" />
                        <DataGridTextColumn Header="OS State" Width="110" Binding="{Binding OsStateText}" />
                        <DataGridTextColumn Header="Priority" Width="80" Binding="{Binding Priority}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab: Call Stack -->
            <TabItem Tag="Call Stack">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/callstack.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Call Stack" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="CallStackGrid" ItemsSource="{Binding CallStack}" IsReadOnly="True"
                          AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                          MouseDoubleClick="OnCallStackDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Follow in Disassembler" Click="OnCallStackFollowDisasm" />
                            <MenuItem Header="Follow in Dump" Click="OnCallStackFollowDump" />
                            <MenuItem Header="Decompile" Click="OnCallStackDecompile" />
                            <MenuItem Header="Copy Address" Click="OnCallStackCopy" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Width="40" Binding="{Binding Index}" />
                        <DataGridTextColumn Header="Return Address" Width="160" Binding="{Binding ReturnAddressHex}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Stack" Width="160" Binding="{Binding StackAddressHex}" />
                        <DataGridTextColumn Header="Symbol" Width="*" Binding="{Binding Symbol}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource CommentBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Bookmarks tab removed — replaced by Bookmarks/Notes plugin -->

            <!-- Tab: Patches -->
            <TabItem Tag="Patches">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/patches.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Patches" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="PatchesGrid" ItemsSource="{Binding Patches}" IsReadOnly="True"
                          AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Restore Original" Click="OnPatchRestore" />
                            <MenuItem Header="Restore All" Command="{Binding RestoreAllPatchesCommand}" />
                            <MenuItem Header="Go to Address" Click="OnPatchGoTo" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Address" Width="160" Binding="{Binding AddressHex}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Size" Width="50" Binding="{Binding Size}" />
                        <DataGridTextColumn Header="Original" Width="200" Binding="{Binding OriginalHex}" />
                        <DataGridTextColumn Header="Patched" Width="200" Binding="{Binding PatchedHex}" />
                        <DataGridTextColumn Header="Module" Width="*" Binding="{Binding ModuleName}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab: Exception Handlers (.pdata + SEH) -->
            <TabItem Tag="Exceptions">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/exceptions.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Exceptions" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2">
                        <TextBlock Text="Filter: " VerticalAlignment="Center" Foreground="{DynamicResource CommentBrush}" />
                        <TextBox Text="{Binding ExceptionFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BgLightBrush}" Foreground="{DynamicResource FgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Padding="3,1" />
                    </DockPanel>
                    <DataGrid x:Name="ExceptionsGrid" ItemsSource="{Binding FilteredExceptions}" IsReadOnly="True"
                              AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                              RowStyle="{StaticResource BpRowStyle}"
                              CellStyle="{StaticResource BpCellStyle}"
                              RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}"
                              MouseDoubleClick="OnExceptionDoubleClick"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Follow Start in Disassembler" Click="OnExceptionFollowDisasm" />
                                <MenuItem Header="Follow End in Disassembler" Click="OnExceptionFollowEnd" />
                                <MenuItem Header="Follow in Dump" Click="OnExceptionFollowDump" />
                                <MenuItem Header="Decompile" Click="OnExceptionDecompile" />
                                <Separator />
                                <MenuItem Header="Set Breakpoint at Start" Click="OnExceptionSetBp" />
                                <MenuItem Header="Set Breakpoint at End" Click="OnExceptionSetBpEnd" />
                                <Separator />
                                <MenuItem Header="Copy Address" Click="OnExceptionCopy" />
                                <MenuItem Header="Copy Function Name" Click="OnExceptionCopyName" />
                                <MenuItem Header="Copy Line" Click="OnExceptionCopyLine" />
                                <Separator />
                                <MenuItem Header="Show Unwind Info" Click="OnExceptionShowUnwind" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Width="140" Binding="{Binding ModuleName}" />
                            <DataGridTextColumn Header="Function" Width="220" Binding="{Binding Display}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CommentBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Start" Width="160" Binding="{Binding StartHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="End" Width="160" Binding="{Binding EndHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Size" Width="80" Binding="{Binding SizeHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource HexBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab: Sections -->
            <TabItem Tag="Sections">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/sections.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sections" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2">
                        <TextBlock Text="Filter: " VerticalAlignment="Center" Foreground="{DynamicResource CommentBrush}" />
                        <TextBox Text="{Binding SectionFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BgLightBrush}" Foreground="{DynamicResource FgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Padding="3,1" />
                    </DockPanel>
                    <DataGrid x:Name="SectionsGrid" ItemsSource="{Binding FilteredSections}" IsReadOnly="True"
                              AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                              RowStyle="{StaticResource BpRowStyle}"
                              CellStyle="{StaticResource BpCellStyle}"
                              RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}"
                              MouseDoubleClick="OnSectionDoubleClick"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Follow in Disassembler" Click="OnSectionFollowDisasm" />
                                <MenuItem Header="Follow in Dump" Click="OnSectionFollowDump" />
                                <Separator />
                                <MenuItem Header="Memory BP on Section (PAGE_GUARD, all pages)" Click="OnSectionMemoryBpAll" />
                                <Separator />
                                <MenuItem Header="Dump Section to File..." Click="OnSectionDumpToFile" />
                                <Separator />
                                <MenuItem Header="Fill Section with NOPs (0x90)" Click="OnSectionFillNops" />
                                <MenuItem Header="Fill Section with Zeros (0x00)" Click="OnSectionFillZeros" />
                                <Separator />
                                <MenuItem Header="Search Binary in Section..." Click="OnSectionSearchBinary" />
                                <MenuItem Header="Search String in Section..." Click="OnSectionSearchString" />
                                <Separator />
                                <MenuItem Header="Copy Address" Click="OnSectionCopyAddress" />
                                <MenuItem Header="Copy Section Name" Click="OnSectionCopyName" />
                                <MenuItem Header="Copy Line" Click="OnSectionCopyLine" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Width="140" Binding="{Binding ModuleName}" />
                            <DataGridTextColumn Header="Section" Width="100" Binding="{Binding Name}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CommentBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Virtual Address" Width="160" Binding="{Binding VaHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Virtual Size" Width="100" Binding="{Binding VirtualSizeHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource HexBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Raw Size" Width="100" Binding="{Binding RawSizeHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource HexBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Flags" Width="*" Binding="{Binding Flags}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CommentBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab: Strings -->
            <TabItem Tag="Strings">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/strings.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Strings" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2">
                        <TextBlock Text="Filter: " VerticalAlignment="Center" Foreground="{DynamicResource CommentBrush}" />
                        <TextBox Text="{Binding StringFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BgLightBrush}" Foreground="{DynamicResource FgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Padding="3,1" />
                    </DockPanel>
                    <DataGrid x:Name="StringsGrid" ItemsSource="{Binding FilteredStrings}" IsReadOnly="True"
                              AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                              RowStyle="{StaticResource BpRowStyle}"
                              CellStyle="{StaticResource BpCellStyle}"
                              RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}"
                              MouseDoubleClick="OnStringDoubleClick"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Follow in Disassembler" Click="OnStringFollowDisasm" />
                                <MenuItem Header="Follow in Dump" Click="OnStringFollowDump" />
                                <Separator />
                                <MenuItem Header="Set Breakpoint" Click="OnStringSetBreakpoint" />
                                <Separator />
                                <MenuItem Header="Copy Address" Click="OnStringCopyAddress" />
                                <MenuItem Header="Copy String" Click="OnStringCopyValue" />
                                <MenuItem Header="Copy Line" Click="OnStringCopyLine" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Width="120" Binding="{Binding ModuleName}" />
                            <DataGridTextColumn Header="Section" Width="70" Binding="{Binding SectionName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CommentBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Address" Width="150" Binding="{Binding AddressHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Type" Width="60" Binding="{Binding TypeName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CommentBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Length" Width="50" Binding="{Binding Length}" />
                            <DataGridTextColumn Header="String" Width="*" Binding="{Binding Value}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource HexBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab: Search -->
            <TabItem Tag="Search">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/search.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Search" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="SearchGrid" ItemsSource="{Binding SearchResults}" IsReadOnly="True"
                          AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                          RowStyle="{StaticResource BpRowStyle}"
                          CellStyle="{StaticResource BpCellStyle}"
                          RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}"
                          MouseDoubleClick="OnSearchResultDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Follow in Disassembler" Click="OnSearchFollowDisasm" />
                            <MenuItem Header="Follow in Dump" Click="OnSearchFollowDump" />
                            <MenuItem Header="Decompile" Click="OnSearchDecompile" />
                            <MenuItem Header="Set Breakpoint" Click="OnSearchSetBp" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Address" Width="160" Binding="{Binding AddressHex}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Module" Width="120" Binding="{Binding ModuleName}" />
                        <DataGridTextColumn Header="Preview" Width="*" Binding="{Binding Preview}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab: Imports -->
            <TabItem Tag="Imports">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/imports.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Imports" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2">
                        <TextBlock Text="Filter: " VerticalAlignment="Center" Foreground="{DynamicResource CommentBrush}" />
                        <TextBox Text="{Binding ImportFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BgLightBrush}" Foreground="{DynamicResource FgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Padding="3,1" />
                    </DockPanel>
                    <DataGrid x:Name="ImportsGrid" ItemsSource="{Binding FilteredImports}" IsReadOnly="True"
                              AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                              RowStyle="{StaticResource BpRowStyle}"
                              CellStyle="{StaticResource BpCellStyle}"
                              RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}"
                              MouseDoubleClick="OnImportDoubleClick"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Follow in Disassembler" Click="OnImportFollowDisasm" />
                                <MenuItem Header="Follow in Dump" Click="OnImportFollowDump" />
                                <MenuItem Header="Decompile" Click="OnImportDecompile" />
                                <MenuItem Header="Set Breakpoint on Function" Click="OnImportSetBp" />
                                <MenuItem Header="Copy Address" Click="OnImportCopy" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Width="140" Binding="{Binding Module}" />
                            <DataGridTextColumn Header="Function" Width="220" Binding="{Binding Display}" />
                            <DataGridTextColumn Header="IAT Address" Width="160" Binding="{Binding IatHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Resolved" Width="*" Binding="{Binding ResolvedHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource HexBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab: Exports -->
            <TabItem Tag="Exports">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/exports.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Exports" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2">
                        <TextBlock Text="Filter: " VerticalAlignment="Center" Foreground="{DynamicResource CommentBrush}" />
                        <TextBox Text="{Binding ExportFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BgLightBrush}" Foreground="{DynamicResource FgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Padding="3,1" />
                    </DockPanel>
                    <DataGrid x:Name="ExportsGrid" ItemsSource="{Binding FilteredExports}" IsReadOnly="True"
                              AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                              RowStyle="{StaticResource BpRowStyle}"
                              CellStyle="{StaticResource BpCellStyle}"
                              RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}"
                              MouseDoubleClick="OnExportDoubleClick"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Follow in Disassembler" Click="OnExportFollowDisasm" />
                                <MenuItem Header="Follow in Dump" Click="OnExportFollowDump" />
                                <MenuItem Header="Decompile" Click="OnExportDecompile" />
                                <MenuItem Header="Set Breakpoint" Click="OnExportSetBp" />
                                <MenuItem Header="Copy Address" Click="OnExportCopy" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Module" Width="140" Binding="{Binding Module}" />
                            <DataGridTextColumn Header="Function" Width="220" Binding="{Binding Display}" />
                            <DataGridTextColumn Header="Ordinal" Width="60" Binding="{Binding Ordinal}" />
                            <DataGridTextColumn Header="Address" Width="*" Binding="{Binding AddressHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab: Functions -->
            <TabItem Tag="Functions">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/functions.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Functions" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2">
                        <TextBlock Text="Filter: " VerticalAlignment="Center" Foreground="{DynamicResource CommentBrush}" />
                        <TextBox x:Name="FunctionFilterBox" Text="{Binding FunctionFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BgLightBrush}" Foreground="{DynamicResource FgBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" Padding="3,1" />
                    </DockPanel>
                    <DataGrid x:Name="FunctionsGrid" ItemsSource="{Binding FilteredFunctions}" IsReadOnly="True"
                              AutoGenerateColumns="False" BorderBrush="{DynamicResource BorderBrush}"
                              RowStyle="{StaticResource BpRowStyle}"
                              CellStyle="{StaticResource BpCellStyle}"
                              RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}"
                              MouseDoubleClick="OnFunctionDoubleClick"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Follow in Disassembler" Click="OnFunctionFollowDisasm" />
                                <MenuItem Header="Decompile" Click="OnFunctionDecompile" />
                                <MenuItem Header="Set Breakpoint" Click="OnFunctionSetBp" />
                                <MenuItem Header="Copy Address" Click="OnFunctionCopy" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Function" Width="350" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Address" Width="160" Binding="{Binding AddressHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AddressBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Size" Width="*" Binding="{Binding SizeHex}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource HexBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab: Decompiler -->
            <TabItem Tag="Decompiler" x:Name="DecompilerTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/decompiler.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Decompiler" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBgBrush}" Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Decompiler (RetDec)" FontWeight="SemiBold" Margin="0,0,12,0" />
                            <TextBlock Text="Decompiling..." Foreground="{DynamicResource CommentBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding IsDecompiling, Converter={StaticResource BoolVisConv}}" />
                        </StackPanel>
                    </Border>
                    <ae:TextEditor x:Name="DecompilerOutput"
                                   IsReadOnly="True"
                                   FontFamily="Lucida Console" FontSize="12"
                                   BorderBrush="{DynamicResource BorderBrush}"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"
                                   ShowLineNumbers="True"
                                   WordWrap="False" />
                </DockPanel>
            </TabItem>

            <!-- Tab: Log -->
            <TabItem Tag="Log">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Resources/Icons/Tabs/log.svg" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Log" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogMessages}"
                         BorderBrush="{DynamicResource BorderBrush}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy All" Click="OnLogCopyAll" />
                            <MenuItem Header="Clear" Click="OnLogClear" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource CommentBrush}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </TabItem>

            </TabControl>

            <GridSplitter Grid.Row="2" Height="3" Background="{DynamicResource BorderBrush}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center" />

            <!-- Bottom: Hex Dump (left) + Stack (right) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BotLeftCol" Width="3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="BotRightCol" Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- Hex Dump -->
                <DockPanel Grid.Column="0">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBgBrush}" Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hex Dump" FontWeight="SemiBold" Margin="0,0,12,0" />
                            <TextBlock Text="Address:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="HexAddrBox" Width="160" VerticalAlignment="Center"
                                     KeyDown="OnHexAddrKeyDown" />
                            <Button Content="Go" Click="OnHexGoClick" Margin="4,0" />
                        </StackPanel>
                    </Border>
                    <ctrl:HexDumpView x:Name="HexDumpControl" />
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource BorderBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                <!-- Stack -->
                <DockPanel Grid.Column="2">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBgBrush}" Padding="4,2">
                        <TextBlock Text="Stack" FontWeight="SemiBold" />
                    </Border>
                    <Grid>
                        <ListBox x:Name="StackList" ItemsSource="{Binding StackEntries}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="4,1"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:StackEntry}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Tag.OffsetW, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            <ColumnDefinition Width="{Binding Tag.AddrW, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Offset}" FontFamily="Lucida Console"
                                                   FontSize="{DynamicResource StackFontSize}"
                                                   Foreground="{DynamicResource StackOffsetBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="Lucida Console"
                                                   FontSize="{DynamicResource StackFontSize}"
                                                   Foreground="{DynamicResource StackAddressBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Annotation, TargetNullValue=''}"
                                                   FontFamily="Lucida Console" FontSize="{DynamicResource StackFontSize}"
                                                   Foreground="{DynamicResource StackAnnotationBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Follow in Dump" Click="OnStackFollowInDump" />
                                    <MenuItem Header="Follow in Disassembler" Click="OnStackFollowInDisasm" />
                                    <MenuItem Header="Copy" Click="OnStackCopy" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <!-- Column resize overlay -->
                        <Grid x:Name="StackColumnOverlay" IsHitTestVisible="True" HorizontalAlignment="Left">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="StackColumnXform"/>
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="StackOffsetCol" Width="60"/>
                                <ColumnDefinition x:Name="StackAddrCol" Width="160"/>
                            </Grid.ColumnDefinitions>
                            <Thumb Grid.Column="0" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                                   DragDelta="OnStackSplitterDrag0">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Line X1="3" Y1="0" X2="3" Y2="10000" Stroke="{DynamicResource SplitterDashBrush}"
                                                  StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb Grid.Column="1" Width="6" HorizontalAlignment="Right" Cursor="SizeWE"
                                   DragDelta="OnStackSplitterDrag1">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Line X1="3" Y1="0" X2="3" Y2="10000" Stroke="{DynamicResource SplitterDashBrush}"
                                                  StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
