<Window x:Class="KernelFlirt.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#1E1E1E" Foreground="#D4D4D4"
        FontFamily="Consolas" FontSize="13">

    <DockPanel Margin="12">
        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset Defaults" Click="OnResetDefaults" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="OK" Click="OnOk" IsDefault="True" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" Padding="12,6" />
        </StackPanel>

        <!-- Main tabs -->
        <TabControl x:Name="MainTabs">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel x:Name="PanelGeneral" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Tab Style">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel x:Name="PanelTabStyle" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Disassembly">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel x:Name="PanelDisasm" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Per-Tab Headers">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel x:Name="PanelPerTab" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
