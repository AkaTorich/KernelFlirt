<Window x:Class="KernelFlirt.UI.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Color" Width="400" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="Consolas" FontSize="13">

    <StackPanel Margin="16">
        <TextBlock Text="Enter hex color (#RRGGBB):" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="TxtHex" Width="120" Padding="4"
                     Background="{DynamicResource BgPanelBrush}" Foreground="{DynamicResource FgBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource FgBrush}"
                     TextChanged="OnHexChanged" />
            <Border x:Name="Preview" Width="100" Height="28" Margin="12,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2"
                    Cursor="Hand" MouseLeftButtonDown="OnPreviewClick"
                    ToolTip="Click to open system color picker" />
        </StackPanel>

        <TextBlock Text="Presets:" Foreground="{DynamicResource FgDimBrush}" Margin="0,0,0,4" />

        <!-- Row 1: Dark backgrounds -->
        <WrapPanel Margin="0,0,0,4">
            <Button Content="" Width="24" Height="24" Margin="2" Background="#000000" Click="OnPreset" Tag="#000000" BorderBrush="#555" BorderThickness="1" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#0D0D0D" Click="OnPreset" Tag="#0D0D0D" BorderBrush="#555" BorderThickness="1" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#1E1E1E" Click="OnPreset" Tag="#1E1E1E" BorderBrush="#555" BorderThickness="1" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#252526" Click="OnPreset" Tag="#252526" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#2D2D30" Click="OnPreset" Tag="#2D2D30" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#333337" Click="OnPreset" Tag="#333337" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#3E3E42" Click="OnPreset" Tag="#3E3E42" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#3F3F46" Click="OnPreset" Tag="#3F3F46" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#505050" Click="OnPreset" Tag="#505050" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#686868" Click="OnPreset" Tag="#686868" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#808080" Click="OnPreset" Tag="#808080" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#A0A0A0" Click="OnPreset" Tag="#A0A0A0" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#C0C0C0" Click="OnPreset" Tag="#C0C0C0" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#D4D4D4" Click="OnPreset" Tag="#D4D4D4" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#FFFFFF" Click="OnPreset" Tag="#FFFFFF" BorderThickness="0" />
        </WrapPanel>

        <!-- Row 2: Blues / Accents -->
        <WrapPanel Margin="0,0,0,4">
            <Button Content="" Width="24" Height="24" Margin="2" Background="#264F78" Click="OnPreset" Tag="#264F78" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#005A9E" Click="OnPreset" Tag="#005A9E" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#007ACC" Click="OnPreset" Tag="#007ACC" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#569CD6" Click="OnPreset" Tag="#569CD6" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#9CDCFE" Click="OnPreset" Tag="#9CDCFE" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#4FC1FF" Click="OnPreset" Tag="#4FC1FF" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#B267E6" Click="OnPreset" Tag="#B267E6" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#C586C0" Click="OnPreset" Tag="#C586C0" BorderThickness="0" />
        </WrapPanel>

        <!-- Row 3: Greens / Yellows / Reds -->
        <WrapPanel Margin="0,0,0,4">
            <Button Content="" Width="24" Height="24" Margin="2" Background="#6A9955" Click="OnPreset" Tag="#6A9955" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#4EC9B0" Click="OnPreset" Tag="#4EC9B0" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#B5CEA8" Click="OnPreset" Tag="#B5CEA8" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#DCDCAA" Click="OnPreset" Tag="#DCDCAA" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#D7BA7D" Click="OnPreset" Tag="#D7BA7D" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#CE9178" Click="OnPreset" Tag="#CE9178" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#D16969" Click="OnPreset" Tag="#D16969" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#FF6B6B" Click="OnPreset" Tag="#FF6B6B" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#E51400" Click="OnPreset" Tag="#E51400" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#8B2020" Click="OnPreset" Tag="#8B2020" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#F44747" Click="OnPreset" Tag="#F44747" BorderThickness="0" />
            <Button Content="" Width="24" Height="24" Margin="2" Background="#FF8C00" Click="OnPreset" Tag="#FF8C00" BorderThickness="0" />
        </WrapPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Click="OnOk" IsDefault="True" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" Padding="12,6" />
        </StackPanel>
    </StackPanel>
</Window>
