<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>KernelFlirt.Cli</RootNamespace>
    <AssemblyName>KfConsole</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="ReadLine.Reboot" Version="3.4.1" />
  </ItemGroup>

  <!-- Свежие dbghelp.dll + symsrv.dll нужны для SymFindFileInPathW (скачивания PDB
       с msdl). Системные версии в System32 часто без symsrv и качание не работает.
       Содержимое KD/ копируется рядом с EXE, .NET loader подхватит их первыми. -->
  <ItemGroup>
    <Content Include="..\..\KD\dbghelp.dll" Link="dbghelp.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\KD\symsrv.dll" Link="symsrv.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\KD\dbgcore.dll" Link="dbgcore.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\KD\srcsrv.dll" Link="srcsrv.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\KD\DbgModel.dll" Link="DbgModel.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
